<job>
problem_id = HSE      # problem ID: basename of output filenames

<output1>
file_type  = hdf5        # Binary data dump
variable   = prim       # variables to be output
dt         = 1.0      # time increment between outputs
xdmf=0

<output2>
file_type  = hst      # history
dt         = 1.0     # time increment between outputs


<output8>
file_type  = rst       # Restart dump
dt         = 1e99      # time increment between outputs

<time>
cfl_number = 0.3        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1      # cycle limit
tlim       = 100.0      # time limit
integrator = vl2
xorder = 2

<mesh>
nx1        = 256            # Number of zones in X1-direction
x1rat      = 1.0273507681792973        # ratio between adjacent cell sizes
x1min      = 0.1                      # minimum value of X1
x1max      = 100                    # maximum value of X1
ix1_bc     = reflecting      # inner-X1 boundary flag
ox1_bc     = user            # outer-X1 boundary flag

nx2        = 1              # Number of zones in X2-direction
x2min      = 0.0            # minimum value of X2
x2max      = 3.141592653589793   # maximum value of X2
ix2_bc     = reflecting        # inner-X2 boundary flag
ox2_bc     = reflecting      # outer-X2 boundary flag

nx3        = 1          # Number of zones in X3-direction
x3min      = 0.0 # minimum value of X3
x3max      = 6.283185307179586  # maximum value of X3
ix3_bc     = reflecting        # inner-X3 boundary flag
ox3_bc     = reflecting        # outer-X3 boundary flag

refinement     = static

<meshblock>
nx1        = 16        # Number of zones per MeshBlock in X1-direction
nx2        = 1         # Number of zones per MeshBlock in X2-direction
nx3        = 1        # Number of zones per MeshBlock in X3-direction



<hydro>
gamma           = 1.33333333333333  # gamma = C_p/C_v
iso_sound_speed = 1.0
dfloor = 1.0e-16
pfloor = 1.0e-16

<problem>
Ggrav           = 1.0
rstar_initial = 1.0
mstar_initial = 1.0

pamb          = 1.0e-99           # ambient pressure
damb          = 1.0e-99

trelax        =   10.0   # relax (damping) for this time
tau_relax_start = 0.01  # initial damping timescale
tau_relax_end   = 1000.0

update_grav_every = 1 # how many steps between gravity update


L_heat = 1.0e-2
t_heat = -1
r_heat_in = 0.5
r_heat_out = 0.55
